{
	"name": "magocracy",
	"description": "A real-time city building strategy game.",
	"author": "Filip Cihak <filip.cihak@fit.cvut.cz>",
	"license": "MIT",
	"licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
	"scripts": {
		"server:dev": "bun --watch src/server/index.ts --port 8081",
		"server:prod": "bun src/server/index.ts",
		"client:dev": "VITE_MULTIPLAYER_SERVER_URL=http://localhost:8081 bunx --bun vite --config vite/config.dev.mjs --port 8080",
		"client:smoke": "VITE_MULTIPLAYER_SERVER_URL=http://localhost:8081 bunx --bun vite --config vite/config.dev.mjs --port 8080 --open /?solo",
		"client:build": "bash -c 'if [ -z \"$SERVER_URL\" ]; then echo \"Error: SERVER_URL env var must be set.\"; exit 1; fi; VITE_MULTIPLAYER_SERVER_URL=$SERVER_URL bunx --bun vite build --config vite/config.prod.mjs'",
		"test": "bun test tests/"
	},
	"devDependencies": {
		"@types/node": "^24.6.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"terser": "^5.44.0",
		"typescript": "~5.9.3",
		"vite": "^7.2.2"
	},
	"dependencies": {
		"phaser": "^3.90.0",
		"socket.io": "^4.8.1",
		"socket.io-client": "^4.8.1"
	}
}